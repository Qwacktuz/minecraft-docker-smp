#!/usr/bin/env bash
# One entry point for the Minecraft world, run from the laptop or from GitHub
# Actions (.github/workflows/server.yml: start/stop buttons and the idle auto-stop).
#
#   bin/server start vps     create the Hetzner VPS and run the world there
#   bin/server start local   run a read-only copy of the world on this machine
#   bin/server stop          shut down; on the VPS: final backup, delete the VPS
#   bin/server status        where is the world running?
#   bin/server prune         delete rarely visited chunks on the VPS (--dry-run)
#   bin/server vault         copy the backups into the locked vault bucket now
#   bin/server tofu <args>   run OpenTofu by hand with the infra secrets
#   bin/server watchdog      deploy the idle auto-stop Worker (watchdog/, Cloudflare)
#
# Backups (read-only; they work from the laptop with no VPS):
#   bin/server backups [--vault]        list the snapshots with their dates and tags
#   bin/server check [percent] [--vault]  check the backups' integrity (default 5%)
#   bin/server unpin <id> [--yes]       let retention delete a checked pre-prune snapshot
#   bin/server drill [snapshot-id]      restore a local copy from the vault, check
#                                       that it starts, stop it again
#
# Restores (admins only, never from GitHub):
#   bin/server restore <id> [--yes]     VPS running: safety backup, then restore <id>
#                                       otherwise: a read-only local copy of <id>
#   bin/server restore <id> --region <overworld|nether|end> <x> <z> [radius] [--yes]
#                                       restore only the region files around x, z (VPS)
#   bin/server rollback [--yes]         restore the newest safety backup; with no VPS,
#                                       starts the VPS from it
#
# There is one world. It lives in R2 (Restic) between runs. Only the VPS writes
# to R2: `stop` there shuts down after a fresh backup is verified. `start`
# restores the newest VPS snapshot; a local copy is never backed up.
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"
# Shared with the host scripts: WORLD_HOST and the pinned images.
# shellcheck source=scripts/lib.sh
. "$ROOT/scripts/lib.sh"

HOST=${TS_HOST:-mc-prod}                 # Tailscale name; infra var.server_name
SSH_USER=${SSH_USER:-deployer}           # infra var.username
REPO=${REPO:-https://github.com/Qwacktuz/minecraft-docker-smp.git}
AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}
WORLD=data/minecraft/world/level.dat     # present once a world has been restored
SAFETY_TAG=pre-restore                   # the safety backup restores take first
SAFETY_KEEP=3                            # newest safety backups that keep the tag
YES=                                     # --yes: don't ask before restoring

die() { echo "server: $*" >&2; exit 1; }
say() { echo "==> $*"; }
need() { for tool; do command -v "$tool" >/dev/null || die "'$tool' is not installed or not on PATH"; done; }

# --- OpenTofu (VPS lifecycle) ------------------------------------------------

# Provider and state-backend credentials live encrypted in secrets/infra.enc.env,
# app secrets (the backups' keys) in secrets/app.enc.env. They are decrypted
# only into the environment of the process that needs them.
INFRA_SECRETS="$ROOT/secrets/infra.enc.env"
APP_SECRETS="$ROOT/secrets/app.enc.env"
# `secrets infra|app|all <hidden command> [args]` runs `bin/server <hidden
# command>` with those secret files decrypted into its environment.
secrets() {
  local files=() command i
  case $1 in
    infra) files=("$INFRA_SECRETS") ;;
    app) files=("$APP_SECRETS") ;;
    all) files=("$APP_SECRETS" "$INFRA_SECRETS") ;;
    *) die "unknown secrets '$1'" ;;
  esac
  shift
  # sops runs its command through a shell, so each layer is quoted once.
  command=$(printf '%q ' "$0" "$@")
  for (( i = ${#files[@]} - 1; i > 0; i-- )); do
    command=$(printf '%q ' sops exec-env "${files[i]}" "$command")
  done
  sops exec-env "${files[0]}" "$command"
}
tf() {
  need sops tofu
  secrets infra _tofu "$@"
}
TF_READY=
tf_init() {
  [[ -n "$TF_READY" ]] && return
  need sops tofu
  secrets infra _tofu-init >/dev/null || die "tofu init failed"
  TF_READY=1
}
vps_exists() {
  local resources
  tf_init
  # A failed state read must stop us, never look like "no VPS". A state that
  # doesn't exist yet (a fresh state bucket) means no VPS.
  if ! resources=$(tf state list 2>&1); then
    grep -q "No state file was found" <<< "$resources" && return 1
    echo "$resources" >&2
    die "could not read the OpenTofu state"
  fi
  grep -qx hcloud_server.minecraft <<< "$resources"
}

# --- Where commands run --------------------------------------------------------

# Tailscale authenticates the host, and every VPS is new, so don't pin host keys.
remote() {
  ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o LogLevel=ERROR \
      -o ConnectTimeout=10 "$SSH_USER@$HOST" "$@"
}
local_running() {
  command -v docker >/dev/null &&
    docker compose ps --status running --services 2>/dev/null | grep -qx minecraft-service
}
# `on local|vps <shell command>` runs a command inside the app directory.
on() {
  local where=$1; shift
  if [[ "$where" == local ]]; then bash -c "$*"; else remote "cd ~/app && $*"; fi
}
where_running() {
  if local_running; then echo local
  elif vps_exists; then echo vps
  else echo none
  fi
}

# --- Backups -------------------------------------------------------------------

# Reads restic snapshot JSON on stdin and prints "<epoch> <id>" per snapshot,
# newest first. Fails when there are none.
snapshot_list() { python3 "$ROOT/scripts/snapshots.py"; }
# `restic` runs inside the VPS backup container, limited to the VPS snapshots.
# It waits for locks, e.g. while the container checks the repository at startup.
vps_restic() { on vps "docker compose exec -T backup restic --retry-lock 2m $* --host $WORLD_HOST"; }

# Backs up the VPS world now and checks that the snapshot reached R2. Sets
# SNAPSHOT_ID. The game keeps running if anything fails.
verified_backup() {
  local message=$1 started latest
  say "Taking a backup on the VPS..."
  started=$(on vps date -u +%s)
  on vps "docker compose exec -T minecraft-service rcon-cli $(printf %q "say $message")" || true
  on vps "docker compose exec -T backup backup now" || die "backup failed; the server is still running"
  latest=$(vps_restic snapshots --latest 1 --json | snapshot_list | head -n1) ||
    die "could not read the latest snapshot; the server is still running"
  (( ${latest% *} >= started )) || die "no new snapshot appeared in R2; the server is still running"
  SNAPSHOT_ID=${latest#* }
  say "Backup ${SNAPSHOT_ID:0:8} verified in R2."
}

# Copies the backup repository's files into the vault bucket. Runs on the
# laptop (or the GitHub runner) under both secret files: it reads the backups
# with the VPS key and writes with the vault key, which never reaches the VPS. Only adds files, so
# R2 bucket locks can stop anything in the vault from being deleted for 30 days.
# A copy of the vault is a complete restic repository (same password).
# R2_* and VAULT_* come from `secrets all` (SC2031: lib.sh restic() reads ./.env in a subshell).
# shellcheck disable=SC2154,SC2031
vault_copy() {
  need rclone
  export RCLONE_CONFIG_BACKUPS_TYPE=s3 RCLONE_CONFIG_BACKUPS_PROVIDER=Cloudflare \
    RCLONE_CONFIG_BACKUPS_ENDPOINT="$R2_ENDPOINT" \
    RCLONE_CONFIG_BACKUPS_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID" \
    RCLONE_CONFIG_BACKUPS_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY"
  export RCLONE_CONFIG_VAULT_TYPE=s3 RCLONE_CONFIG_VAULT_PROVIDER=Cloudflare \
    RCLONE_CONFIG_VAULT_ENDPOINT="$R2_ENDPOINT" RCLONE_CONFIG_VAULT_NO_CHECK_BUCKET=true \
    RCLONE_CONFIG_VAULT_ACCESS_KEY_ID="$VAULT_ACCESS_KEY_ID" \
    RCLONE_CONFIG_VAULT_SECRET_ACCESS_KEY="$VAULT_SECRET_ACCESS_KEY"
  # Restic files are content-addressed and never change, so existing ones are skipped.
  rclone copy "backups:$R2_BUCKET_NAME" "vault:$VAULT_BUCKET" --ignore-existing \
    --include "/config" --include "/keys/**" --include "/data/**" \
    --include "/index/**" --include "/snapshots/**" --transfers 8 --stats-one-line --stats 30s
}
vault() {
  say "Copying the backups into the vault bucket ($VAULT_BUCKET)..."
  secrets all _vault-copy
}

# Pauses the backup alert check (healthchecks.io) while the server is stopped,
# so the missing pings don't alert. The next backup ping resumes it. Does
# nothing unless BACKUP_PING_URL (app) and HEALTHCHECKS_API_KEY (infra) are set.
# shellcheck disable=SC2031 # the values come from `secrets all`, not a subshell
pause_alerts() {
  [[ -n "${BACKUP_PING_URL:-}" && -n "${HEALTHCHECKS_API_KEY:-}" ]] || return 0
  local check=${BACKUP_PING_URL%/}
  check=${check##*/}
  [[ "$check" =~ ^[0-9a-f-]{36}$ ]] || { echo "BACKUP_PING_URL must be a UUID ping URL" >&2; return 1; }
  # The API key goes to curl on stdin, never in its arguments.
  printf 'header = "X-Api-Key: %s"\n' "$HEALTHCHECKS_API_KEY" |
    curl -fsS -m 10 -K - -X POST "https://healthchecks.io/api/v3/checks/$check/pause" >/dev/null
}

# `keep_tagged <tag> <snapshot> <n>` tags a VPS snapshot and keeps the tag on
# the newest <n> only; older ones fall back to normal retention (compose.yml
# keeps tagged snapshots). <n> = 0 keeps every tag until `server unpin`.
# Prints the newest tagged snapshot's ID.
keep_tagged() {
  local tag=$1 snapshot=$2 keep=$3 snaps old
  vps_restic tag --add "$tag" "$snapshot" >/dev/null || die "could not tag snapshot ${snapshot:0:8} $tag"
  snaps=$(vps_restic snapshots --tag "$tag" --json | snapshot_list) || die "could not list the $tag snapshots"
  if (( keep > 0 )); then
    old=$(tail -n +"$((keep + 1))" <<< "$snaps" | cut -d' ' -f2 | tr '\n' ' ')
    if [[ -n "$old" ]]; then vps_restic tag --remove "$tag" "$old" >/dev/null || true; fi
  fi
  head -n1 <<< "$snaps" | cut -d' ' -f2
}

# --- Pruning -------------------------------------------------------------------

prune_settings() {
  # shellcheck disable=SC1091 # prune/settings.env
  . "$ROOT/prune/settings.env"
}

# Backs up, tags the snapshot pre-prune (for rollbacks), prunes, restarts.
prune_vps() {
  prune_settings
  verified_backup "Restarting in a moment for world maintenance (pruning unused chunks)..."
  local rollback
  rollback=$(keep_tagged pre-prune "$SNAPSHOT_ID" "$PRUNE_KEEP_SNAPSHOTS")

  say "Stopping the game to prune..."
  on vps "docker compose stop minecraft-service backup"
  if ! on vps "bash scripts/prune.sh"; then
    on vps "docker compose up -d --wait --wait-timeout 600" || true
    die "pruning failed; the game was restarted. Pre-prune snapshot: ${rollback:0:8}"
  fi
  say "Starting the game again..."
  on vps "docker compose up -d --wait --wait-timeout 600" ||
    die "the game did not become healthy after pruning. Pre-prune snapshot: ${rollback:0:8}"
  say "Pruned. Pre-prune snapshot for rollbacks: ${rollback:0:8}"
}

# True when automatic pruning is on and the last prune is older than AUTO_PRUNE_DAYS.
prune_due() {
  prune_settings
  (( AUTO_PRUNE_DAYS > 0 )) || return 1
  local json last=0
  json=$(vps_restic snapshots --tag pre-prune --json) ||
    { echo "warning: could not check when the world was last pruned; skipping" >&2; return 1; }
  if last=$(snapshot_list <<< "$json" | head -n1); then last=${last% *}; else last=0; fi
  (( $(date +%s) - last >= AUTO_PRUNE_DAYS * 86400 ))
}

# --- Commands ------------------------------------------------------------------

# `start_local [snapshot-id]`: without an ID, restores the newest snapshot
# (or keeps a running copy as it is); with one, always restores that.
start_local() {
  need docker sops tofu
  [[ -f "$AGE_KEY_FILE" ]] || die "Age key not found at $AGE_KEY_FILE"
  local restore=${1:-latest}
  if local_running; then
    if [[ -z "${1:-}" ]]; then
      say "Already running locally; redeploying without restoring."
      restore=
    fi
  elif vps_exists; then
    die "the world is running on the VPS; run 'bin/server stop' first"
  fi
  SOPS_AGE_KEY_FILE="$AGE_KEY_FILE" APP_DIR="$ROOT" RESTORE="$restore" BACKUPS='' \
    bash scripts/deploy.sh
  [[ -n "${1:-}" ]] && say "Restored snapshot $1 locally."
  say "Running locally: connect to localhost:25565"
  say "This is a read-only copy: nothing done here is saved to R2."
}

# `start_vps [snapshot-id]`: a new VPS restores that snapshot (default: the newest).
start_vps() {
  need tofu git ssh
  [[ -f "$AGE_KEY_FILE" ]] || die "Age key not found at $AGE_KEY_FILE"
  local_running && die "the world is running locally; run 'bin/server stop' first"

  # The VPS deploys a commit from GitHub, so it must be pushed.
  local sha remote_name
  sha=$(git rev-parse HEAD)
  remote_name=$(git remote | head -n1)
  git fetch --quiet "$remote_name"
  [[ -n "$(git branch -r --contains "$sha")" ]] ||
    die "commit ${sha:0:7} is not pushed to '$remote_name'; push it first"
  # Ignore mode-only changes (this checkout has many 644->755 flips).
  [[ -z "$(git -c core.fileMode=false status --porcelain --untracked-files=no)" ]] ||
    echo "warning: uncommitted changes are not deployed; the VPS runs ${sha:0:7}" >&2

  # Restore unless the VPS already holds a world (a half-finished start has none).
  local restore=${1:-latest}
  if vps_exists; then
    remote true || die "the VPS exists but is unreachable over Tailscale SSH"
    if remote "test -f ~/app/$WORLD"; then
      restore=
      say "The VPS already runs the world; redeploying without restoring."
    fi
  fi

  say "Creating or updating the VPS..."
  tf apply -input=false -auto-approve

  say "Waiting for $HOST to join the tailnet..."
  local tries=0
  until remote true 2>/dev/null; do
    (( ++tries <= 60 )) || die "$HOST did not become reachable over Tailscale SSH"
    sleep 10
  done
  # Separate session: the deploy must log in after cloud-init has added the
  # user to the docker group, or it can't reach the Docker socket.
  remote "sudo cloud-init status --wait >/dev/null" || die "cloud-init failed on $HOST"

  say "Deploying ${sha:0:7}..."
  # The Age key travels over SSH stdin: never in arguments, env files, or disk.
  # shellcheck disable=SC2016 # expanded on the VPS
  local script='set -eu
SOPS_AGE_KEY=$(cat); export SOPS_AGE_KEY
mkdir -p ~/app && cd ~/app
exec 9>~/.minecraft-deploy.lock; flock -w 1800 9
[ -d .git ] || git clone -q "$REPO" .
git fetch -q origin "$SHA" && git reset -q --hard "$SHA"
APP_DIR="$HOME/app" RESTORE="$RESTORE" BACKUPS=1 bash scripts/deploy.sh'
  remote "$(printf 'REPO=%q SHA=%q RESTORE=%q bash -c %q' "$REPO" "$sha" "$restore" "$script")" \
    < <(grep '^AGE-SECRET-KEY-' "$AGE_KEY_FILE")

  say "Running on the VPS: mc.cactuz.dev ($(tf output -raw ipv4_address))"
}

stop() {
  need tofu
  local where
  where=$(where_running)
  if [[ "$where" == none ]]; then say "Nothing is running."; return; fi

  if [[ "$where" == local ]]; then
    say "Stopping the local copy (nothing is saved to R2)..."
    on local "docker compose down"
    say "Stopped."
    return
  fi

  remote true 2>/dev/null ||
    die "a VPS exists but is unreachable; check it before destroying (tofu -chdir=infra destroy)"
  if prune_due; then
    say "The last prune is more than $AUTO_PRUNE_DAYS days old; pruning first."
    prune_vps
  fi
  verified_backup "Server shutting down for a final backup..."
  # The VPS disk holds the only other copy of the world: never delete it when
  # the backups look damaged.
  say "Checking the backups' integrity (reading 2% of the data)..."
  local check
  check=$(on vps "docker compose exec -T backup restic --retry-lock 2m check --read-data-subset 2%" 2>&1) ||
    { tail -n 20 <<< "$check" >&2; die "the backups failed their integrity check; the server is still running"; }
  say "Stopping containers..."
  on vps "docker compose down"
  # A public download of the world (no player data); never blocks the stop.
  on vps "bash scripts/publish-world.sh" ||
    echo "warning: could not publish world.zip; the backup in R2 is safe" >&2

  say "Deleting the VPS..."
  remote "sudo tailscale logout" 2>/dev/null || true
  tf destroy -input=false -auto-approve
  # Free the name so the next VPS joins as '$HOST', not '$HOST-1'.
  secrets infra _forget-device "$HOST" ||
    echo "warning: could not remove $HOST from the tailnet; delete it in the Tailscale admin console" >&2
  secrets all _pause-alerts ||
    echo "warning: could not pause the backup alert check; expect an alert" >&2
  vault || echo "warning: could not copy the backups into the vault; run 'bin/server vault' later" >&2
  say "Stopped. The world is safe in R2."
}

# Deploys the idle auto-stop Worker (watchdog/) to Cloudflare with wrangler.
# Runs under `secrets all`: WATCHDOG_CLOUDFLARE_TOKEN (Workers Scripts and KV
# Edit) deploys it, WATCHDOG_GITHUB_TOKEN (Actions: read and write on this
# repository only) becomes its one secret, and the account ID comes from R2_ENDPOINT.
# shellcheck disable=SC2154 # R2_ENDPOINT and WATCHDOG_* come from sops exec-env
watchdog_deploy() {
  need wrangler
  [[ -n "${WATCHDOG_CLOUDFLARE_TOKEN:-}" && -n "${WATCHDOG_GITHUB_TOKEN:-}" ]] ||
    die "add WATCHDOG_CLOUDFLARE_TOKEN and WATCHDOG_GITHUB_TOKEN to secrets/infra.enc.env (docs/auto-stop.md)"
  local account=${R2_ENDPOINT#https://} id
  account=${account%%.*}
  [[ "$account" =~ ^[0-9a-f]{32}$ ]] || die "could not read the Cloudflare account ID from R2_ENDPOINT"
  export CLOUDFLARE_ACCOUNT_ID=$account CLOUDFLARE_API_TOKEN=$WATCHDOG_CLOUDFLARE_TOKEN
  cd "$ROOT/watchdog"
  if grep -q REPLACE_WITH_KV_ID wrangler.toml; then
    say "Creating the Worker's KV namespace (once)..."
    id=$(wrangler kv namespace create mc-idle-watchdog-state 2>&1 | grep -oE '[0-9a-f]{32}' | head -n1 || true)
    [[ -n "$id" ]] || die "could not create the KV namespace"
    sed -i.bak "s/REPLACE_WITH_KV_ID/$id/" wrangler.toml && rm -f wrangler.toml.bak
    say "KV namespace $id written to watchdog/wrangler.toml; commit it."
  fi
  wrangler deploy
  # The token goes to wrangler on stdin, never in its arguments.
  printf '%s' "$WATCHDOG_GITHUB_TOKEN" | wrangler secret put GITHUB_TOKEN
}

# Deletes tailnet devices named $1 via the Tailscale API. Runs under
# `secrets infra`, which provides the OAuth client credentials.
# shellcheck disable=SC2154 # TF_VAR_* come from sops exec-env
forget_device() {
  local api=https://api.tailscale.com/api/v2 token id
  token=$(printf 'client_id=%s&client_secret=%s' "$TF_VAR_ts_oauth_client_id" "$TF_VAR_ts_oauth_client_secret" |
    curl -sf -d @- "$api/oauth/token" | jq -re .access_token) || return 1
  auth() { printf 'header = "Authorization: Bearer %s"\n' "$token"; }
  for id in $(auth | curl -sf -K - "$api/tailnet/-/devices" |
              jq -r --arg host "$1" '.devices[] | select(.hostname == $host) | .id'); do
    auth | curl -sf -K - -X DELETE "$api/device/$id" >/dev/null || return 1
  done
}

status() {
  need tofu
  local where
  where=$(where_running)
  case "$where" in
    none) say "Stopped (the world is in R2)."; return ;;
    local) say "Running locally (a read-only copy; nothing is saved to R2)."; return ;;
    vps) say "Running on the VPS ($HOST)." ;;
  esac
  local latest
  if latest=$(vps_restic snapshots --latest 1 --json | snapshot_list | head -n1); then
    latest=${latest% *}
    say "Latest backup: $(date -r "$latest" 2>/dev/null || date -d "@$latest")"
  else
    say "Latest backup: unknown"
  fi
}

prune() {
  local where
  where=$(where_running)
  case "${1:-}" in
    --dry-run)
      [[ "$where" != none ]] ||
        die "nothing is running; start the world first ('start local' is fine for a dry run)"
      on "$where" "bash scripts/prune.sh --dry-run" ;;
    "")
      [[ "$where" == vps ]] ||
        die "pruning changes the real world, which runs on the VPS; the local copy is read-only (use --dry-run)"
      prune_vps ;;
    *) usage 1 >&2 ;;
  esac
}

# --- Backups from the laptop (read-only) ---------------------------------------

# `laptop_restic <args>` runs restic here (scripts/lib.sh, in the backup image)
# with the decrypted app secrets; RESTIC_SOURCE=vault adds the infra secrets
# for the vault's keys. Never needs the VPS.
laptop_restic() {
  need docker sops
  if [[ "${RESTIC_SOURCE:-}" == vault ]]; then secrets all _restic "$@"; else secrets app _restic "$@"; fi
}
# `source_flag [--vault]` sets RESTIC_SOURCE for the commands that take --vault.
source_flag() {
  case "${1:-}" in
    "") ;;
    --vault) export RESTIC_SOURCE=vault ;;
    *) usage 1 >&2 ;;
  esac
}
source_name() { if [[ "${RESTIC_SOURCE:-}" == vault ]]; then echo "the vault ($VAULT_BUCKET)"; else echo "R2"; fi; }

# `unpin <id>` removes the pre-prune tag from a snapshot once the pruned world
# has been checked in game; normal retention may then delete it. Runs in the
# VPS backup container when the VPS is up, else from the laptop.
unpin() {
  [[ -n "${1:-}" ]] || usage 1 >&2
  local id=$1
  [[ "$id" =~ ^[0-9a-f]{8,64}$ ]] || die "'$id' is not a snapshot ID"
  confirm "Unpin snapshot $id? Normal retention may then delete it from R2 (the vault keeps its copy)."
  if [[ "$(where_running)" == vps ]]; then
    vps_restic tag --remove pre-prune "$id" >/dev/null || die "could not unpin $id"
  else
    laptop_restic --retry-lock 2m tag --remove pre-prune "$id" --host "$WORLD_HOST" >/dev/null ||
      die "could not unpin $id"
  fi
  say "Unpinned $id."
}

backups() {
  source_flag "${1:-}"
  say "Backups of the world in $(source_name) (newest last):"
  laptop_restic --no-lock snapshots --host "$WORLD_HOST" --compact
}

check() {
  local percent=5
  if [[ "${1:-}" =~ ^[0-9] ]]; then percent=$1; shift; fi
  source_flag "${1:-}"
  [[ "$percent" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "the percentage must be a number, not '$percent'"
  need docker sops
  say "Checking the backups in $(source_name) from this machine (reading $percent% of the data)..."
  # No lock: the check writes nothing, and doesn't block a running VPS's backups.
  local group=app
  [[ "${RESTIC_SOURCE:-}" == vault ]] && group=all
  secrets "$group" _check "$percent"
}

# Restores a read-only local copy from the vault, waits until the game passes
# its health check, then stops it. Proves the vault alone can bring the world back.
drill() {
  need docker sops
  [[ -f "$AGE_KEY_FILE" ]] || die "Age key not found at $AGE_KEY_FILE"
  local snapshot=${1:-latest}
  [[ "$snapshot" =~ ^(latest|[0-9a-f]+)$ ]] || die "not a snapshot ID: $snapshot"
  local_running && die "a local copy is running; run 'bin/server stop' first"
  say "Drill: restoring $snapshot from the vault ($VAULT_BUCKET) into a local read-only copy..."
  # The vault keys are infra secrets; deploy.sh decrypts the app secrets itself.
  if ! RESTIC_SOURCE=vault SOPS_AGE_KEY_FILE="$AGE_KEY_FILE" APP_DIR="$ROOT" RESTORE="$snapshot" \
       BACKUPS='' secrets infra _deploy; then
    on local "docker compose down" || true
    die "the drill failed: the vault copy did not restore or start (see above)"
  fi
  [[ -f "$ROOT/$WORLD" ]] || { on local "docker compose down" || true; die "the drill failed: no level.dat after the restore"; }
  say "The vault copy started and passed its health check. Stopping it..."
  on local "docker compose down"
  say "Drill passed. The restored copy stays in data/minecraft (read-only; nothing was written to R2 or the vault)."
}

# --- Restores (admins only) ----------------------------------------------------

confirm() {
  [[ -n "$YES" ]] && return 0
  local answer=''
  read -r -p "$1 [y/N] " answer || true
  [[ "$answer" =~ ^[yY] ]] || { say "Aborted."; exit 0; }
}
# `vps_snapshot <id|latest>` prints the full ID of a VPS snapshot (host WORLD_HOST only).
vps_snapshot() {
  vps_restic snapshots --json | python3 "$ROOT/scripts/snapshots.py" --find "$1"
}
# Takes a verified backup and tags it as the safety backup. Sets SAFETY_ID.
safety_backup() {
  verified_backup "$1"
  # `restic tag` rewrites the snapshot under a new ID: use the tagged one's.
  SAFETY_ID=$(keep_tagged "$SAFETY_TAG" "$SNAPSHOT_ID" "$SAFETY_KEEP")
  say "Safety backup: ${SAFETY_ID:0:8} ('bin/server rollback' restores it)."
}
# Runs a restore.sh command on the VPS under the deploy lock, with the backup
# container stopped: it must not back up a half-restored world, and it must be
# recreated so that it doesn't keep the moved-aside world mounted.
vps_restore_run() {
  on vps "exec 9>~/.minecraft-deploy.lock && flock -w 600 9 &&
    docker compose stop backup &&
    bash scripts/restore.sh $* &&
    docker compose up -d --force-recreate --wait --wait-timeout 600 backup"
}

# `restore <id> [--region <dim> <x> <z> [radius]] [--yes]`
restore() {
  local snapshot='' region=() arg
  while (( $# )); do
    arg=$1; shift
    case "$arg" in
      -y | --yes) YES=1 ;;
      --region)
        (( $# >= 3 )) || die "--region needs <overworld|nether|end> <x> <z> [radius]"
        region=("$1" "$2" "$3"); shift 3
        if [[ "${1:-}" =~ ^[0-9]+$ ]]; then region+=("$1"); shift; fi ;;
      -*) usage 1 >&2 ;;
      *) [[ -z "$snapshot" ]] || usage 1 >&2; snapshot=$arg ;;
    esac
  done
  [[ -n "$snapshot" ]] || die "which snapshot? 'bin/server backups' lists them"
  [[ "$snapshot" =~ ^(latest|[0-9a-f]+)$ ]] || die "not a snapshot ID: $snapshot"

  local paths=()
  if (( ${#region[@]} )); then
    local list
    list=$(python3 "$ROOT/scripts/regions.py" "${region[@]}") || exit 2
    while IFS= read -r arg; do paths+=("$arg"); done <<< "$list"
  fi

  local where
  where=$(where_running)
  if [[ "$where" != vps ]]; then
    (( ${#paths[@]} == 0 )) ||
      die "a region restore changes the real world, which runs on the VPS; start it first ('bin/server start vps')"
    say "The VPS is not running: starting a read-only local copy of $snapshot instead."
    start_local "$snapshot"
    return
  fi

  local full
  full=$(vps_snapshot "$snapshot") ||
    die "no single $WORLD_HOST snapshot matches '$snapshot' ('bin/server backups' lists them)"
  if (( ${#paths[@]} )); then
    printf '  %s\n' "${paths[@]}"
    confirm "Restore these ${#paths[@]} region file(s) (and their entities/poi) from ${full:0:8} on the VPS? Changes made there since are lost."
  else
    confirm "Replace the world on the VPS with snapshot ${full:0:8}? Everything since is lost (a safety backup is taken first)."
  fi
  # ${a[@]+...}: an empty array is "unbound" under set -u in macOS's bash 3.2.
  vps_restore "$full" ${paths[@]+"${paths[@]}"}
}
# `vps_restore <full-id> [region paths...]`: safety backup, then the restore.
vps_restore() {
  local full=$1; shift
  safety_backup "Restoring an older backup; the server restarts in a moment..."
  if (( $# )); then
    say "Restoring $# region file(s) from ${full:0:8}..."
    vps_restore_run "regions $(printf '%q ' "$full" "$@")" ||
      die "the region restore failed. Safety backup: ${SAFETY_ID:0:8}; check 'docker compose ps' on the VPS"
    say "Restored $# region file(s) from ${full:0:8}. Undo: 'bin/server rollback' (safety backup ${SAFETY_ID:0:8})."
  else
    say "Restoring ${full:0:8}..."
    vps_restore_run "world $(printf %q "$full") --yes" ||
      die "the restore failed. Safety backup: ${SAFETY_ID:0:8}; the old world is in data/minecraft_pre_restore_* on the VPS"
    say "Restored ${full:0:8}. Undo: 'bin/server rollback' (safety backup ${SAFETY_ID:0:8})."
  fi
}

# Restores the newest safety backup. It lives in R2, so this works after the
# VPS was deleted too: then the VPS is started from it.
rollback() {
  case "${1:-}" in -y | --yes) YES=1 ;; "") ;; *) usage 1 >&2 ;; esac
  local where json latest safety when
  where=$(where_running)
  [[ "$where" != local ]] ||
    die "a rollback changes the real world; stop the local copy first ('bin/server stop')"
  if [[ "$where" == vps ]]; then
    json=$(vps_restic snapshots --tag "$SAFETY_TAG" --json) || die "could not list the safety backups"
  else
    json=$(laptop_restic --no-lock snapshots --tag "$SAFETY_TAG" --host "$WORLD_HOST" --json) ||
      die "could not list the safety backups"
  fi
  latest=$(snapshot_list <<< "$json" | head -n1) || die "there is no safety backup (tag $SAFETY_TAG) to roll back to"
  safety=${latest#* }
  when=$(date -r "${latest% *}" 2>/dev/null || date -d "@${latest% *}")
  if [[ "$where" == vps ]]; then
    confirm "Roll the world on the VPS back to safety backup ${safety:0:8} ($when)? A new safety backup is taken first."
    YES=1
    vps_restore "$safety"
  else
    confirm "The VPS is off. Start it from safety backup ${safety:0:8} ($when) instead of the newest backup?"
    start_vps "$safety"
  fi
}

unpin_args() {
  local id=''
  for arg; do
    case "$arg" in --yes | -y) YES=1 ;; *) id=$arg ;; esac
  done
  unpin "$id"
}

usage() { sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

# Runs tofu init with the state bucket from the decrypted infra secrets.
# shellcheck disable=SC2154 # TOFU_BACKEND_* come from secrets/infra.enc.env
tofu_init() {
  tofu -chdir="$ROOT/infra" init -input=false -reconfigure \
    -backend-config="bucket=${TOFU_BACKEND_BUCKET:-}" -backend-config="endpoint=${TOFU_BACKEND_ENDPOINT:-}"
}

case "${1:-} ${2:-}" in
  "start local") start_local ;;
  "start vps") start_vps ;;
  "stop "*) stop ;;
  "status "*) status ;;
  "prune "*) prune "${2:-}" ;;
  "vault "*) vault ;;
  "watchdog "*) say "Deploying the idle auto-stop Worker..."; secrets all _watchdog-deploy ;;
  "tofu "*) shift; tf_init; tf "$@" ;;
  "backups "*) backups "${2:-}" ;;
  "check "*) shift; check "$@" ;;
  "drill "*) drill "${2:-}" ;;
  "restore "*) shift; restore "$@" ;;
  "rollback "*) rollback "${2:-}" ;;
  "unpin "*) shift; unpin_args "$@" ;;
  "-h "* | "--help "* | "help "*) usage ;;
  # Hidden commands: `secrets` runs these with the decrypted values in the environment.
  "_tofu "*) shift; tofu -chdir="$ROOT/infra" "$@" ;;
  "_tofu-init "*) tofu_init ;;
  "_vault-copy "*) vault_copy ;;
  "_pause-alerts "*) pause_alerts ;;
  "_forget-device "*) forget_device "$2" ;;
  "_watchdog-deploy "*) watchdog_deploy ;;
  "_restic "*) shift; restic "$@" ;;
  "_check "*) RESTIC_NO_LOCK=1 APP_DIR="$ROOT" bash "$ROOT/scripts/test-backup.sh" "$2" ;;
  "_deploy "*) bash "$ROOT/scripts/deploy.sh" ;;
  *) usage 1 >&2 ;;
esac
