# Copy to .env for manual use; CI decrypts secrets/secrets.enc.env instead.
# Use the host's Tailscale IPv4 in production. Loopback keeps admin UIs local.
# Game and voice/webcam ports remain published on all interfaces.
TS_IP=127.0.0.1
MC_WHITELIST=
MC_OPS=
RCON_PASSWORD=
GRAFANA_PASSWORD=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=
ARCANE_ENCRYPTION_KEY=
ARCANE_JWT_SECRET=
