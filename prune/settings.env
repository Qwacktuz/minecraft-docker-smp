# Chunk pruning (scripts/prune.sh, `server prune`). See docs/pruning.md.
# A chunk is deleted only when it fails EVERY keep rule below.

# Keep chunks where players have spent at least this long in total.
PRUNE_MIN_INHABITED="10 minutes"
# Keep chunks saved by the game within this many days (recently visited).
PRUNE_UNTOUCHED_DAYS=60
# Keep this many chunks around each player's position and respawn point.
PRUNE_PLAYER_RADIUS=12
# Also keep this many chunks around every kept chunk (no seams next to builds).
PRUNE_BUFFER=4
# Refuse to prune a dimension that would lose more than this share of its chunks
# (a guard against a broken query that keeps almost nothing).
PRUNE_MAX_PERCENT=98

# `server stop` prunes the VPS world first when the last prune is older than
# this many days. 0 turns automatic pruning off.
AUTO_PRUNE_DAYS=0
# How many pre-prune snapshots keep their tag (pinned in R2 for rollbacks).
# 0 = all of them, until an admin checks the pruned world in game and runs
# `server unpin <id>`.
PRUNE_KEEP_SNAPSHOTS=0
